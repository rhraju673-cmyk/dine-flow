# ─────────────────────────────────────────────────────────────
# DineFlow environment variables
# Copy this file to ".env" (same folder) and adjust the values.
# NEVER commit your real .env file. It is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# "development" | "test" | "production"
NODE_ENV=development

# Port of the Express API server (the Vite dev server proxies /api to it)
API_PORT=4000

# Comma-separated list of browser origins allowed to call the API
# (the Vite dev server runs on 5173 by default)
CLIENT_ORIGIN=http://localhost:5173

# ── Database ────────────────────────────────────────────────
# Main development database
DATABASE_URL=postgresql://dineflow:change_me_local_password@localhost:5433/dineflow?schema=public
# Separate database used ONLY by the automated tests (it is wiped on every run!)
TEST_DATABASE_URL=postgresql://dineflow:change_me_local_password@localhost:5433/dineflow_test?schema=public

# true  = DineFlow starts its own local PostgreSQL (no installation needed),
#         using the user/password/port written in DATABASE_URL above.
# false = you run PostgreSQL yourself (installed locally, Docker, cloud...).
USE_EMBEDDED_POSTGRES=true

# ── Security ───────────────────────────────────────────────
# Long random string used to sign CSRF tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string_of_at_least_32_characters

# How long a login session lasts (days)
SESSION_TTL_DAYS=7

# Login attempts allowed per IP address within the window
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# ── Business defaults ──────────────────────────────────────
# Length of the free trial created during onboarding (days)
TRIAL_DAYS=14
