{
  "name": "dineflow",
  "version": "0.1.0",
  "private": true,
  "description": "DineFlow — Restaurant QR Ordering & Management SaaS (Phase 1: Foundation)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "setup": "npm run setup -w server",
    "dev": "concurrently -k -n db,api,web -c gray,blue,magenta \"npm:db:start\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:app": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "db:start": "npm run db:start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:seed": "npm run db:seed -w server",
    "db:reset": "npm run db:reset -w server",
    "db:studio": "npm run db:studio -w server",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "build": "npm run build -w client && npm run build -w server",
    "build:prod": "npm run db:generate -w server && npm run build && npm run db:deploy:prod -w server",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@embedded-postgres/windows-x64@17.12.0-beta.19": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
